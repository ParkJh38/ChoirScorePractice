<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/input_intro" />
        <Button
            android:id="@+id/select_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/select_pdf" />
        <TextView
            android:id="@+id/pdf_filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_pdf"
            android:textIsSelectable="true" />
        <TextView
            android:id="@+id/pdf_access_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <Button
            android:id="@+id/view_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_pdf"
            android:enabled="false" />
        <Button
            android:id="@+id/import_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/import_txt" />
        <TextView
            android:id="@+id/txt_filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_txt"
            android:textIsSelectable="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/pronunciation"
            android:text="@string/pronunciation_label" />
        <EditText
            android:id="@+id/pronunciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:importantForAutofill="no"
            android:minLines="6"
            android:saveEnabled="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_help" />
        <ProgressBar
            android:id="@+id/import_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
        <TextView
            android:id="@+id/input_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
